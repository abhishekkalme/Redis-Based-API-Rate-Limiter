{
  "name": "advanced-rate-limiter",
  "version": "2.0.0",
  "description": "Distributed API rate limiter with multiple strategies (Token Bucket, Leaky Bucket, Sliding Window Log, Sliding Window Counter), Redis-backed atomic operations, Docker orchestration, and Prometheus monitoring.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/lua', 'dist/lua', {recursive: true}); require('fs').cpSync('public', 'dist/public', {recursive: true})\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "benchmark": "k6 run k6-script.js"
  },
  "keywords": [
    "rate-limiter",
    "token-bucket",
    "leaky-bucket",
    "sliding-window",
    "redis",
    "express",
    "distributed",
    "prometheus"
  ],
  "author": "Abhishek Kalme",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "redis": "^5.10.0",
    "response-time": "^2.3.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.0",
    "@types/response-time": "^2.3.8",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
