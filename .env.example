# Server
NODE_ENV=production
PORT=3000

# Redis — required for distributed rate limiting.
# Local / docker-compose: redis://redis:6379
# PaaS add-on (Railway/Fly/Upstash): use the provided REDIS_URL
# Upstash (free tier): use the rediss:// URL from your Upstash console and set REDIS_TLS=true
REDIS_URL=redis://localhost:6379

# Enable TLS for managed Redis (Upstash, Redis Cloud, etc.)
REDIS_TLS=false

# Default rate limiting strategy
# token-bucket | leaky-bucket | sliding-window-log | sliding-window-counter
RATE_LIMIT_STRATEGY=token-bucket

# Logging level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
